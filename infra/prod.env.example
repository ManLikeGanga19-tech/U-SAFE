# U-SAFE KE — production env for the VPS. Copy to /opt/usafe/prod.env (outside the
# repo) and fill in. Never commit the real file.
#   cp /opt/usafe/app/infra/prod.env.example /opt/usafe/prod.env && chmod 600 /opt/usafe/prod.env

ENVIRONMENT=production
PROJECT_NAME=U-SAFE KE

# Generate: openssl rand -hex 32
JWT_SECRET=

# Vercel frontends (comma-separated, no trailing slash)
CORS_ORIGINS=https://www.u-safe.co.ke,https://u-safe.co.ke,https://admin.u-safe.co.ke

# Postgres (container-local; used by both the postgres container and the API)
# Generate the password: openssl rand -hex 24
POSTGRES_USER=usafe
POSTGRES_PASSWORD=
POSTGRES_DB=usafe

# First admin, created on first boot
FIRST_ADMIN_EMAIL=admin@u-safe.co.ke
FIRST_ADMIN_PASSWORD=
SEED_DEMO_PRODUCTS=false

# Cloudflare R2 (same values as on Render). ALL are required for admin image
# uploads + quote PDFs. If any is blank the API refuses uploads with a 503 naming
# what's missing, and /api/v1/health reports "media_storage":"not_configured".
# The R2 token needs Object Read & Write on this bucket.
S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
S3_PUBLIC_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=usafe-media
# Public URL of the bucket root, e.g. https://pub-xxxx.r2.dev or https://media.u-safe.co.ke
S3_PUBLIC_BASE_URL=

# M-Pesa (Daraja)
MPESA_MODE=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://api.u-safe.co.ke/api/v1/payments/mpesa/callback
