# U-SAFE KE — production env for the VPS. Copy to /opt/usafe/prod.env (outside the
# repo) and fill in. Never commit the real file.
#   cp /opt/usafe/app/infra/prod.env.example /opt/usafe/prod.env && chmod 600 /opt/usafe/prod.env

ENVIRONMENT=production
PROJECT_NAME=U-SAFE KE

# Generate: openssl rand -hex 32
JWT_SECRET=

# Vercel frontends (comma-separated, no trailing slash)
CORS_ORIGINS=https://www.u-safe.co.ke,https://u-safe.co.ke,https://admin.u-safe.co.ke

# Postgres (container-local; used by both the postgres container and the API)
# Generate the password: openssl rand -hex 24
POSTGRES_USER=usafe
POSTGRES_PASSWORD=
POSTGRES_DB=usafe

# First admin, created on first boot
FIRST_ADMIN_EMAIL=admin@u-safe.co.ke
FIRST_ADMIN_PASSWORD=
SEED_DEMO_PRODUCTS=false

# Media is stored on the VPS itself (STORAGE_BACKEND=local, set in
# docker-compose.prod.yml) and served at https://api.u-safe.co.ke/media.
# Nothing to configure here. S3_* vars are only needed if you ever switch
# back to an S3-compatible store (STORAGE_BACKEND=s3).

# M-Pesa (Daraja)
MPESA_MODE=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://api.u-safe.co.ke/api/v1/payments/mpesa/callback
